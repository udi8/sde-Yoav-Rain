rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin status lives in the `admins` collection (doc id = lowercase
    // email), not a hardcoded list — existing admins add/remove others from
    // the admin page. `exists()` here reads the doc directly regardless of
    // the `admins` match block's own allow rules below.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // ─── Rainfall readings ──────────────────────────────────────────────
    // One doc per date (doc id = "YYYY-MM-DD"). `source` distinguishes
    // 'whatsapp-import' | 'manual' (daily admin form) | 'historical'
    // (pre-2021 data typed in later from Yigal's 1991 paper records).
    match /readings/{date} {
      allow read: if true; // public page needs no auth
      allow write: if isAdmin();
    }

    // ─── Admins ───────────────────────────────────────────────────────
    // A signed-in user may always check their own admin doc (so the app can
    // tell them whether they're allowed in); only admins can list everyone
    // or add/remove entries. The very first admin has to be seeded directly
    // via a service account (scripts/bootstrapAdmin.js), since no one can
    // satisfy isAdmin() before any doc exists.
    match /admins/{adminId} {
      allow get: if request.auth != null &&
        (request.auth.token.email.lower() == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
